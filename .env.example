# ==============================================================================
# OmniEarth - Universal Environment & Provider Credentials Template
# ==============================================================================
# Note: Providers like Open-Meteo, AWS Open Data (Sentinel-2, Landsat-8/9 COGs),
# SoilGrids, and Copernicus DEM work out-of-the-box with ZERO credentials!
#
# To enable access to protected or on-demand providers (EnMAP, PRISMA, NASA EMIT, CDSE),
# configure your free accounts below and rename this file to `.env`.
# ==============================================================================

# --- 1. German Aerospace Center (DLR) Geoservice (EnMAP Hyperspectral) ---
# Register free at: https://sso.eoc.dlr.de/geoservice/selfservice/register?locale=en
DLR_USERNAME=
DLR_PASSWORD=

# --- 2. Italian Space Agency (ASI) PRISMA (Hyperspectral 240 bands) ---
# Register free at: https://prisma.asi.it/
PRISMA_USERNAME=
PRISMA_PASSWORD=

# --- 3. NASA Earthdata (EMIT Hyperspectral, GPM Precipitation, SMAP) ---
# Register free at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- 4. Copernicus Data Space Ecosystem (CDSE) / S3 ---
# Register free at: https://dataspace.copernicus.eu/
CDSE_USERNAME=
CDSE_PASSWORD=

# --- 5. CODE-DE / CloudFerro Object Storage (S3 eodata bucket) ---
# Generate keys at: https://tenant-manager.code-de.org/panel/s3-keys-eo
ACCESS_KEY=
SECRET_KEY=

# --- 6. Optional OmniEarth Configuration ---
OMNIEARTH_DEFAULT_OUTDIR=./downloads
OMNIEARTH_TIMEOUT_SEC=30
OMNIEARTH_MAX_RETRIES=3
